# Core application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication
NEXTAUTH_SECRET="replace-with-a-secure-random-string"

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Email defaults (used when no custom settings are stored)
EMAIL_SERVER="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="apikey"
EMAIL_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="Portfolio <noreply@example.com>"
ADMIN_EMAIL="admin@example.com"
SEND_AUTO_REPLY="false"

# Development SMTP fallbacks (Ethereal)
ETHEREAL_EMAIL=""
ETHEREAL_PASSWORD=""

# Analytics and verification
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
IP_HASH_SALT="replace-with-random-salt"

# Registration (off unless "true"; applies once at least one account exists)
ALLOW_REGISTRATION="false"

# First admin account. On an empty database only this address may register and it becomes the
# admin. Compared case-insensitively after trimming. Leave empty to keep the first registration
# closed (fail closed). Set it to your own address before the instance is reachable publicly.
ADMIN_BOOTSTRAP_EMAIL=""
# Secret for the first registration (at least 32 characters, e.g. `openssl rand -hex 32`).
# Required together with ADMIN_BOOTSTRAP_EMAIL; entered in the "Setup token" field on /register.
# Has no effect once an account exists. Remove it after the admin account was created.
ADMIN_BOOTSTRAP_TOKEN=""

# Server logs: files under logs/ except on Vercel/Netlify/Lambda. "false" disables, "true" forces.
LOG_TO_FILE=""

# Live updates over Socket.IO (read at build time). Off unless "true"; keep it off on Vercel.
NEXT_PUBLIC_REALTIME_ENABLED="false"
