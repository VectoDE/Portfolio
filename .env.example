# Core application URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Authentication (required, no fallback: without it sign-in and protected APIs fail with 500)
# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=""

# Database
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Email defaults (used when no custom settings are stored)
EMAIL_SERVER="smtp.example.com"
EMAIL_PORT="587"
EMAIL_USER="apikey"
EMAIL_PASSWORD="replace-with-smtp-password"
EMAIL_FROM="Portfolio <noreply@example.com>"
ADMIN_EMAIL="admin@example.com"
SEND_AUTO_REPLY="false"

# Development SMTP fallbacks (Ethereal)
ETHEREAL_EMAIL=""
ETHEREAL_PASSWORD=""

# Analytics and verification
NEXT_PUBLIC_ENABLE_ANALYTICS="false"
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
NEXT_PUBLIC_BING_SITE_VERIFICATION=""
# Required for visitor IP hashing, no fallback: without it no IP hash is stored
# Generate with: openssl rand -hex 32
IP_HASH_SALT=""

# Registration (off unless "true"; the first account can always be created)
ALLOW_REGISTRATION="false"

# Development seeding (endpoint is disabled in production and without SEED_TOKEN)
SEED_TOKEN=""
SEED_ADMIN_PASSWORD=""
